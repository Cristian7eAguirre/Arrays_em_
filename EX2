#include <stdio.h>

void lerVetor(int v[], int n);
int buscar(int v[], int n, int alvo);
int contar(int v[], int n, int alvo);
void exibirInverso(int v[], int n);

int main() {
    int tamanho = 15;
    int vetor[tamanho];
    int numeroAlvo;

    lerVetor(vetor, tamanho);

    printf("\nDigite um numero inteiro para buscar e contar: ");
    scanf("%d", &numeroAlvo);

    int indice = buscar(vetor, tamanho, numeroAlvo);
    if (indice != -1) {
        printf("O numero %d foi encontrado primeiro no indice: %d\n", numeroAlvo, indice);
    } else {
        printf("O numero %d nao existe no vetor.\n", numeroAlvo);
    }

    int frequencia = contar(vetor, tamanho, numeroAlvo);
    printf("O numero %d aparece %d vez(es) no vetor.\n", numeroAlvo, frequencia);

    printf("\nVetor em ordem inversa:\n");
    exibirInverso(vetor, tamanho);

    return 0;
}


void lerVetor(int v[], int n) {
    printf("Digite %d numeros inteiros:\n", n);
    for (int i = 0; i < n; i++) {
        printf("Elemento [%d]: ", i);
        scanf("%d", &v[i]);
    }
}

int buscar(int v[], int n, int alvo) {
    for (int i = 0; i < n; i++) {
        if (v[i] == alvo) {
            return i; // Retorna o índice onde encontrou primeiro
        }
    }
    return -1; // Se percorrer tudo e não achar, retorna -1
}

int contar(int v[], int n, int alvo) {
    int qtd = 0;
    for (int i = 0; i < n; i++) {
        if (v[i] == alvo) {
            qtd++;
        }
    }
    return qtd;
}

void exibirInverso(int v[], int n) {
    for (int i = n - 1; i >= 0; i--) {
        printf("%d ", v[i]);
    }
    printf("\n");
}
